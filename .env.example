# Copy this file to .env.local and fill in the values you want to use.
# Restart `npm run dev` after editing.

# ---------- AI (Anthropic) ----------
# Without ANTHROPIC_API_KEY, the app uses a context-aware mock (still feels intelligent).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---------- Google Calendar (read-only) ----------
# Get these from https://console.cloud.google.com/ → APIs & Services → Credentials
# Authorized redirect URI in Google Cloud MUST be exactly:
#   http://localhost:3000/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
